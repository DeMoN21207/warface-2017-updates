{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warface update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "gameVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})\\.(0|[1-9][0-9]{0,4})$"
    },
    "gameVersion": {
      "const": "1.14500.1321.41200"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "path",
          "size",
          "sha256",
          "url"
        ],
        "properties": {
          "target": {
            "enum": ["launcher", "client"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "description": "Relative destination; updater must also reject traversal, drive roots, symlinks and protected local configuration paths."
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/DeMoN21207/warface-2017-updates/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9][A-Za-z0-9._-]{0,180}$"
          }
        }
      }
    }
  }
}
