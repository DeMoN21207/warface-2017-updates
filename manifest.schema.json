{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warface update manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "gameVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256",
          "url"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "Relative destination; updater must also reject traversal, drive roots, symlinks and protected local configuration paths."
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/DeMoN21207/warface-2017-updates/releases/download/[^/]+/[^/]+$"
          }
        }
      }
    }
  }
}
